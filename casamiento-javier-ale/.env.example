# ===================== FIREBASE CONFIG =====================
# Copia este archivo a .env y reemplaza los valores

# API Key de Firebase
FIREBASE_API_KEY=YOUR_API_KEY_HERE

# ID del Proyecto
FIREBASE_PROJECT_ID=casamiento-javier-ale

# Auth Domain
FIREBASE_AUTH_DOMAIN=casamiento-javier-ale.firebaseapp.com

# Storage Bucket
FIREBASE_STORAGE_BUCKET=casamiento-javier-ale.appspot.com

# Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=123456789

# App ID
FIREBASE_APP_ID=1:123456789:web:abc123def456

# ===================== NODEMAILER CONFIG =====================
# Para envío automático de emails

EMAIL_SERVICE=gmail
EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ===================== CONFIGURACIÓN DEL EVENTO =====================
EVENT_DATE=2026-12-12
EVENT_TIME=19:00:00
EVENT_LOCATION=Salón Los Alamos
EVENT_ADDRESS=Av. Siempre Viva 123, Buenos Aires

# ===================== INFORMACIÓN BANCARIA =====================
BANK_CBU=0000000000000000000000
BANK_ALIAS=JAVI.ALE.BODA

# ===================== URLS =====================
SITE_URL=https://casamiento-javier-ale.web.app
ADMIN_PANEL_URL=https://console.firebase.google.com/project/casamiento-javier-ale

# ===================== MODO =====================
# development o production
NODE_ENV=production
